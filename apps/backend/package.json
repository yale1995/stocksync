{
	"name": "stocksync-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"worker": "node --env-file-if-exists=.env dist/worker.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"db:up": "docker compose -f src/infra/compose.yaml up -d --wait",
		"db:down": "docker compose -f src/infra/compose.yaml down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file-if-exists=.env src/infra/seed/run.ts"
	},
	"dependencies": {
		"@scalar/express-api-reference": "^0.10.27",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"drizzle-orm": "^0.45.3",
		"express": "^5.2.1",
		"jose": "^6.2.12",
		"pg": "^8.23.1",
		"zod": "^4.6.5",
		"zod-openapi": "^6.0.2"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.1",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"drizzle-kit": "^0.31.11",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
